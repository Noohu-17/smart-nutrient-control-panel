# Settings for the staging stack (infra/docker-compose.staging.yml).
# Copy to infra/.env.staging, which git ignores, and fill in every blank password with a long
# random value, for example from `openssl rand -hex 24`. Never commit real passwords.
# Compose refuses to start while a required value is blank.

# What Caddy serves. On a server, the domain name that points at it, and Caddy gets a public
# certificate. `localhost` is for trying the stack on a laptop, with Caddy's own certificate.
SITE_ADDRESS=localhost

# The site's login: every page and every /api call asks for it, /api/health included.
# SITE_PASSWORD_HASH is a bcrypt hash of the password, never the password itself. Make it with
#   docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# which asks for the password twice and prints the hash. Paste the hash between single quotes,
# as shown, so its $ signs stay as they are.
SITE_USER=
SITE_PASSWORD_HASH=''

# The app's demo mode, true or false, built into the app. The app reads it from T2-17 on.
VITE_DEMO_MODE=false

# The client's config pack, as seen inside the containers (../config is mounted at /config).
CLIENT_DIR=/config/clients/client_A

# PostgreSQL. The password takes effect when the database is first created.
POSTGRES_DB=sna
POSTGRES_USER=sna
POSTGRES_PASSWORD=

# /api/docs and /api/openapi.json stay off on a server.
API_DOCS_ENABLED=false

# One broker login per device and per back-end service (contract 3).
MQTT_PASSWORD_GW1=
MQTT_PASSWORD_ZC1=
MQTT_PASSWORD_ZC2=
MQTT_PASSWORD_CC1=
MQTT_PASSWORD_PM1=
MQTT_PASSWORD_CLOUD_API=
MQTT_PASSWORD_CLOUD_WORKER=

# Simulator: clock speed (one of simulator.json speedOptions) and log level. Leave SIM_SPEED
# empty for the demo's speed (simulator.json demoStart.speed, x60); set it to override.
SIM_SPEED=
LOG_LEVEL=INFO
