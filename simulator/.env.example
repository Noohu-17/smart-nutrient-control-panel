# Copy to simulator/.env and adjust. Real environment variables win over this file.
# Infrastructure only: farm values come from the client config pack.

# MQTT broker (Track 1's dev stack: docker compose -f infra/docker-compose.dev.yml up -d mqtt)
MQTT_HOST=localhost
MQTT_PORT=1883

# One login per device (contract 3): username = device ID. Leave unset for the dev broker,
# which needs no passwords. Never commit real passwords.
# MQTT_PASSWORD_ZC1=

LOG_LEVEL=INFO
